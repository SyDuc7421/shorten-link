# Public hostname (nginx server_name + TLS cert path) — docker-compose.prod.yml
DOMAIN=short.example.com

# Images used by docker-compose.prod.yml: ${IMAGE_PREFIX}-server:${IMAGE_TAG}
IMAGE_PREFIX=shortlink
IMAGE_TAG=latest

# Defaults below target local dev (make run / go run on the host, services from
# docker-compose.yml on localhost). For docker-compose.prod.yml, see docs/deploy.md:
# set DOMAIN, BASE_URL, ALLOWED_ORIGINS and the passwords; the compose file
# overrides MYSQL_HOST, REDIS_ADDR, RABBITMQ_URL and the JWT paths.

# HTTP
PORT=8080
BASE_URL=http://localhost:8080

# Unique per server instance (0-1023); duplicates can produce colliding short codes
NODE_ID=1

# Allowed CORS origins, comma-separated (empty = deny all CORS)
ALLOWED_ORIGINS=http://localhost:3000

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=shortlink
MYSQL_PASSWORD=changeme
MYSQL_DB=shortlink

#  Redis (password required by docker-compose.prod.yml)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=changeme_redis
REDIS_DB=0

#  RabbitMQ
# Local dev: RABBITMQ_URL is used as-is.
# docker-compose.prod.yml builds the URL from RABBITMQ_USER/RABBITMQ_PASSWORD instead.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_USER=shortlink
RABBITMQ_PASSWORD=changeme_rabbit

#  JWT (RSA key paths)
# Generate with: make keys
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

#  Password reset
# GUI page the emailed link opens; ?token=... is appended
PASSWORD_RESET_URL=http://localhost:3000/reset-password

#  SMTP (password reset mail)
# Leave SMTP_HOST empty locally: the reset link is written to the server log instead.
# Production: your provider's SMTP relay, usually port 587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
